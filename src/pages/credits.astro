---
import Base from '../layouts/Base.astro';
import credits from '../data/credits.json';
---
<Base title="Photo credits — Tiwa 'N' Tiwa" description="Photography credits and licences for images used on this site.">
  <section class="pt-32 pb-20 sm:pt-40">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Credits</p>
      <h1 class="mt-3 text-4xl font-medium tracking-tight sm:text-5xl">About the photography</h1>
      <p class="mt-5 text-ink-soft leading-relaxed">{credits.note}</p>
      <ul class="mt-10 divide-y divide-line">
        {credits.images.map((c) => (
          <li class="flex items-center gap-5 py-4">
            <img src={c.file} alt="" width="96" height="96" loading="lazy" class="h-20 w-20 shrink-0 rounded-xl object-cover" />
            <div class="text-sm">
              <p class="font-medium">{c.use}</p>
              <p class="text-ink-soft">{c.title} · {c.author} placeholder, to be replaced with the restaurant’s own photography.</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
