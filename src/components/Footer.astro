---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-white">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <p class="wordmark text-3xl">Tiwa <em>’N’</em> Tiwa</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/65">Nigerian cooking from the charcoal grill and the slow pot. Peckham, London.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn-light">Reservations</a>
        <a href={site.uberEats} target="_blank" rel="noopener" class="btn border border-white/30 text-white hover:bg-white/10">Order delivery</a>
      </div>
    </div>
    <div class="md:col-span-2">
      <p class="eyebrow !text-gold">Find us</p>
      <address class="mt-3 text-sm not-italic leading-relaxed text-white/75">{site.address.line1}<br />{site.address.line2}</address>
      <a href={`tel:${site.phone}`} class="mt-3 block text-sm hover:text-gold">{site.phoneDisplay}</a>
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="mt-1 block text-sm hover:text-gold">WhatsApp</a>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow !text-gold">Hours</p>
      <dl class="mt-3 text-sm text-white/75">
        {site.hours.map((h) => (
          <div class="flex justify-between gap-6 border-b border-white/10 py-2 last:border-0"><dt>{h.days}</dt><dd class="text-white">{h.open} – {h.close === '00:00' ? 'late' : h.close}</dd></div>
        ))}
      </dl>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow !text-gold">Stay in touch</p>
      <p class="mt-3 text-sm leading-relaxed text-white/65">Suya nights, new dishes and events. No spam.</p>
      <form class="mt-4 flex gap-2" action="#" onsubmit="event.preventDefault(); this.querySelector('p').hidden=false;">
        <label class="sr-only" for="nl">Email</label>
        <input id="nl" type="email" required placeholder="you@email.com" class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 focus:border-gold focus:outline-none" />
        <button class="btn-light !px-4">Join</button>
        <p hidden class="basis-full text-xs text-gold">Thanks, you’re on the list.</p>
      </form>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-3 py-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · 34 Peckham High Street, London SE15 5DP</p>
      <div class="flex gap-5">
        <a href={site.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
        <a href="/menu" class="hover:text-white">Menus</a>
        <a href="/credits" class="hover:text-white">Photo credits</a>
      </div>
    </div>
  </div>
</footer>
