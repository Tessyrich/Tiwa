---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transparentHeader?: boolean;
}
const {
  title = `${site.name} — West African Restaurant, Peckham`,
  description = 'Charcoal suya, smoky jollof and slow-cooked Yoruba soups on Peckham High Street. Open seven days for lunch and dinner, dine in, takeaway and delivery.',
  image = '/img/og.jpg',
  transparentHeader = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tiwa-n-tiwa.vercel.app').href;

const openingHours = site.hours.map((h) => {
  const map: Record<string, string[]> = {
    'Monday – Thursday': ['Mo', 'Tu', 'We', 'Th'],
    'Friday – Saturday': ['Fr', 'Sa'],
    'Sunday': ['Su'],
  };
  return { '@type': 'OpeningHoursSpecification', dayOfWeek: map[h.days], opens: h.open, closes: h.close === '00:00' ? '23:59' : h.close };
});
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description,
  image: new URL(image, canonical).href,
  url: canonical,
  telephone: site.phone,
  servesCuisine: ['Nigerian', 'West African'],
  priceRange: '££',
  acceptsReservations: 'True',
  address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: 'London', postalCode: 'SE15 5DP', addressCountry: 'GB' },
  openingHoursSpecification: openingHours,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.score, reviewCount: 235 },
  hasMenu: new URL('/menu', canonical).href,
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical).href} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header transparent={transparentHeader} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
