---
import site from '../data/site.json';
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/menu', label: 'Menus' },
  { href: '/#story', label: 'Our story' },
  { href: '/#gallery', label: 'Gallery' },
  { href: '/#events', label: 'Events' },
  { href: '/#find-us', label: 'Find us' },
];
---
<header id="site-header" class:list={['fixed inset-x-0 top-0 z-50 transition-all duration-300', transparent ? 'text-white hdr-shadow' : 'bg-white/92 backdrop-blur border-b border-line text-ink']} data-transparent={transparent ? 'true' : 'false'}>
  <div class="container-x grid h-16 grid-cols-[1fr_auto] items-center gap-6 sm:h-[76px] lg:grid-cols-[1fr_auto_1fr]">
    <a href="/" class="wordmark text-[22px] sm:text-2xl" aria-label={`${site.name} home`}>Tiwa <em>’N’</em> Tiwa</a>
    <nav class="hidden items-center gap-7 text-[13px] font-medium uppercase tracking-[0.12em] lg:flex" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['opacity-80 transition hover:opacity-100', path === n.href && 'opacity-100 underline underline-offset-8 decoration-ember decoration-2']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center justify-end gap-2">
      <a href={`tel:${site.phone}`} class="hidden text-sm font-medium opacity-80 hover:opacity-100 xl:inline">{site.phoneDisplay}</a>
      <a href={site.bookingUrl} target="_blank" rel="noopener" class:list={['btn !py-2.5 !px-5', transparent ? 'bg-white text-ink hover:bg-cream' : 'bg-ink text-white hover:bg-ember']}>Reservations</a>
      <button id="nav-toggle" class="ml-1 inline-flex h-10 w-10 items-center justify-center rounded-full border border-current/20 lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="hidden border-t border-line bg-white text-ink lg:hidden">
    <nav class="container-x flex flex-col py-3 text-base" aria-label="Mobile">
      {nav.map((n) => <a href={n.href} class="border-b border-line py-3.5 last:border-0">{n.label}</a>)}
      <a href={`tel:${site.phone}`} class="py-3.5 font-medium text-ember">Call {site.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('nav-toggle')!;
  const mobile = document.getElementById('mobile-nav')!;
  const isTransparent = header.dataset.transparent === 'true';
  const solid = ['bg-white/92', 'backdrop-blur', 'border-b', 'border-line', 'text-ink'];
  const bookBtn = header.querySelector('a[target="_blank"]')!;
  function onScroll() {
    if (!isTransparent) return;
    const past = window.scrollY > 40 || !mobile.classList.contains('hidden');
    header.classList.toggle('text-white', !past); header.classList.toggle('hdr-shadow', !past);
    solid.forEach((c) => header.classList.toggle(c, past));
    bookBtn.classList.toggle('bg-white', !past); bookBtn.classList.toggle('text-ink', !past); bookBtn.classList.toggle('hover:bg-cream', !past);
    bookBtn.classList.toggle('bg-ink', past); bookBtn.classList.toggle('text-white', past); bookBtn.classList.toggle('hover:bg-ember', past);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toggle.addEventListener('click', () => {
    const open = mobile.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    onScroll();
  });
  mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { mobile.classList.add('hidden'); toggle.setAttribute('aria-expanded', 'false'); onScroll(); }));
</script>
